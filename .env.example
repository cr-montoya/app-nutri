# Copy to .env.local (or .env for tooling that requires it) and fill in real values.
# Never commit the filled-in file; see .gitignore.

# Postgres connection string (Neon in production/preview; any Postgres 14+ locally).
# Used only for `prisma migrate`. In Neon, use the role that owns the schema.
DATABASE_URL="postgresql://user:password@localhost:5432/appnutri"

# Application/runtime connection string. MUST be a non-superuser role without
# BYPASSRLS, or Postgres Row-Level Security silently does nothing for it --
# see .kiro/specs/phase-0-scaffold/design.md's RLS policy section and
# .agents/rules/tenant-isolation.md. In Neon, create a dedicated least-privilege
# role for this rather than reusing the branch's default owner role.
APP_DATABASE_URL="postgresql://app_user:password@localhost:5432/appnutri"

# Auth.js v5. Generate with: pnpm dlx auth secret
AUTH_SECRET="replace-with-a-generated-secret"
